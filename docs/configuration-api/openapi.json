{
  "openapi": "3.1.0",
  "info": {
    "title": "Price Optimiser Configuration API",
    "version": "1.0.0",
    "description": "Configuration and publishing only. Does not create or manage GAM inventory. Authenticated management API is separate from the public SDK runtime API."
  },
  "servers": [
    {
      "url": "https://{managementHost}/api/v1",
      "variables": {
        "managementHost": {
          "default": "management.example.com"
        }
      }
    }
  ],
  "paths": {
    "/schema": {
      "get": {
        "operationId": "getSchema",
        "summary": "get Schema",
        "description": "Required scope: read",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful read, preview, or already-published request"
          },
          "201": {
            "description": "Draft revision saved; live ads unchanged"
          },
          "202": {
            "description": "Publication queued; poll statusUrl"
          },
          "400": {
            "description": "Invalid JSON"
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key"
          },
          "403": {
            "description": "Insufficient scope, site access or disallowed Origin"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict, active publication or reused idempotency key"
          },
          "422": {
            "description": "Invalid configuration or request"
          },
          "500": {
            "description": "Internal failure; no success claimed"
          }
        }
      }
    },
    "/sites/{siteKey}/configuration": {
      "get": {
        "operationId": "getConfiguration",
