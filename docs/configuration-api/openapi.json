            "schema": {
              "type": "string",
              "maxLength": 191,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read, preview, or already-published request"
          },
          "201": {
            "description": "Draft revision saved; live ads unchanged"
          },
          "202": {
            "description": "Publication queued; poll statusUrl"
          },
          "400": {
            "description": "Invalid JSON"
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key"
          },
          "403": {
            "description": "Insufficient scope, site access or disallowed Origin"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict, active publication or reused idempotency key"
          },
          "422": {
            "description": "Invalid configuration or request"
          },
          "500": {
            "description": "Internal failure; no success claimed"
          }
        }
      },
      "put": {
        "operationId": "saveConfiguration",
        "summary": "save Configuration",
        "description": "Required scope: write",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "siteKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 191,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read, preview, or already-published request"
          },
          "201": {
            "description": "Draft revision saved; live ads unchanged"
          },
          "202": {
            "description": "Publication queued; poll statusUrl"
          },
          "400": {
            "description": "Invalid JSON"
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key"
          },
          "403": {
            "description": "Insufficient scope, site access or disallowed Origin"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict, active publication or reused idempotency key"
