    "/sites/{siteKey}/publisher-instructions": {
      "get": {
        "operationId": "getPublisherInstructions",
        "summary": "get Publisher Instructions",
        "description": "Generate shareable publisher instructions from the last confirmed live revision by default. An explicit non-live revision is labeled draft. Requires read scope.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "siteKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 191,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "enum": [
                "json",
                "markdown"
              ],
              "default": "json"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageKey",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Publisher instructions as JSON or a downloadable Markdown document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "siteKey": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "source": {
                      "enum": [
                        "published",
                        "draft"
                      ]
                    },
                    "pageKey": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "filename": {
                      "type": "string"
                    },
                    "sdk": {
                      "type": "object"
                    },
                    "markdown": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "siteKey",
                    "revision",
                    "source",
                    "pageKey",
                    "filename",
                    "sdk",
                    "markdown"
                  ]
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "201": {
            "description": "Draft revision saved; live ads unchanged"
          },
          "202": {
            "description": "Publication queued; poll statusUrl"
          },
          "400": {
            "description": "Invalid JSON"
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key"
          },
          "403": {
            "description": "Insufficient scope, site access or disallowed Origin"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Revision conflict, active publication or reused idempotency key"
          },
          "422": {
            "description": "Invalid configuration or request"
          },
          "500": {
            "description": "Internal failure; no success claimed"
          }
        }
      }
    },
