  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped po_ API key issued by the operator; keep in your application backend."
      }
    },
    "schemas": {
      "Configuration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "siteKey": {
            "type": "string",
            "maxLength": 191,
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "enabled": {
            "type": "boolean"
          },
          "integrationMode": {
            "enum": [
              "both",
              "auto_placement",
              "waterfall_only"
            ]
          },
          "debug": {
            "type": "boolean"
          },
          "inventory": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "networkCode": {
                "type": "string",
                "pattern": "^[0-9]+(?:,[0-9]+)?$",
                "maxLength": 64
              },
              "deviceRouting": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "tabletInventory": {
                    "const": "desktop"
                  }
                },
                "required": [
                  "enabled",
                  "tabletInventory"
                ]
              }
            },
            "required": [
              "networkCode",
              "deviceRouting"
            ]
          },
          "placements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slotKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 128
                },
                "format": {
                  "enum": [
                    "banner",
                    "native",
                    "anchor",
                    "rewarded",
                    "interstitial"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "pageKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "domId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                  "maxLength": 191
                },
                "sizes": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "anyOf": [
                      {
                        "const": "fluid"
                      },
                      {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4096
                        }
                      }
                    ]
                  }
                },
                "adUnits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "desktop": {
                      "type": "string",
                      "pattern": "^/[0-9]+(?:,[0-9]+)?/[A-Za-z0-9_.:/-]+$",
                      "maxLength": 255
                    },
                    "mobile": {
                      "type": "string",
                      "pattern": "^/[0-9]+(?:,[0-9]+)?/[A-Za-z0-9_.:/-]+$",
                      "maxLength": 255
                    }
                  },
                  "required": [
                    "desktop"
                  ]
                },
                "integrationMode": {
                  "enum": [
                    "both",
                    "auto_placement",
                    "waterfall_only"
                  ]
                },
                "displayPreloadMode": {
                  "enum": [
                    "preparation",
                    "real"
                  ]
                },
                "targetingKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "pos": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "retryLimit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "retryTimeoutMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120000
                },
                "refresh": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "delayMs": {
                      "type": "integer",
                      "minimum": 30000,
                      "maximum": 3600000
                    },
                    "maximum": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "enabled",
                    "delayMs",
                    "maximum"
                  ]
                },
                "rewarded": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requestTimeoutMs": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 120000
                    },
                    "maximumAttempts": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "rewardPoints": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    }
                  },
                  "required": [
                    "requestTimeoutMs",
                    "maximumAttempts",
                    "rewardPoints"
                  ]
                }
              },
              "required": [
                "slotKey",
                "format",
                "enabled",
                "adUnits"
              ]
            }
          },
          "pageRules": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pageKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "pathPattern": {
                  "type": "string",
                  "pattern": "^(?:/[^?#]*|\\*)$",
                  "maxLength": 255
                },
                "enabled": {
                  "type": "boolean"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "integrationMode": {
                  "enum": [
                    "auto_placement",
                    "waterfall_only"
                  ]
                }
              },
              "required": [
                "pageKey",
                "pathPattern",
                "enabled",
                "priority",
                "integrationMode"
              ]
            }
          },
          "experiment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "variantPercentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "enabled",
              "key",
              "variantPercentage"
            ]
          },
          "pricing": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "banner",
                    "native",
                    "anchor",
                    "rewarded",
                    "interstitial"
                  ]
                },
                "region": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "controlFloor": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "variantFloor": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "ladder": {
                  "type": "array",
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  }
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "format",
                "region",
                "controlFloor",
                "variantFloor",
                "ladder",
                "enabled"
              ]
            }
          },
          "optimization": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": [
                    "banner",
                    "native",
                    "anchor",
                    "rewarded",
                    "interstitial"
                  ]
                },
                "mode": {
                  "enum": [
                    "ai_optimized",
                    "observe_only",
                    "manual_floor",
                    "disabled"
                  ]
                },
                "manualFloor": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "format",
                "mode"
              ]
            }
          }
        },
        "required": [
          "siteKey",
          "name",
          "enabled",
          "integrationMode",
          "debug",
          "inventory",
          "placements",
          "pageRules",
          "experiment",
          "pricing",
          "optimization"
        ]
      },
      "PreviewContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device": {
            "enum": [
              "mobile",
              "tablet",
              "desktop",
              "unknown"
            ]
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 2048
          },
          "pageKey": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": []
      }
    }
  }
